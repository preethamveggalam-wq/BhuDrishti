# SMTP used for login-success notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-real-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="BhuDrishti <your-real-email@gmail.com>"

# Optional: provisioned BhuDrishti email/password users (no sign-up UI)
# Example: AUTH_USERS_JSON=[{"email":"officer@example.gov","name":"Officer","password":"replace-me"}]
AUTH_USERS_JSON=[]

# Google OAuth for real Gmail login
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
